[{"path": "C:\\Users\\OthmanM6\\t\\prompt-age\\hr\\templates\\index.html", "existed": true, "content": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Gomaa Relay</title>\n  <link rel=\"stylesheet\" href=\"{{ url_for('static', filename='style.css') }}\">\n</head>\n<body>\n  <header class=\"topbar\">\n    <div class=\"brand\">\n      Gomaa Relay\n      <span class=\"badge\">Mo · Gomaa</span>\n      <span class=\"badge\">#No Api Cost</span>\n      <div class=\"led-cluster\" title=\"System Health & Self-Heal Status\">\n        <span id=\"greenLed\" class=\"led green on\" title=\"Healthy / Auto-Relay Active\"></span>\n        <button id=\"redLed\" class=\"led red\" title=\"No failures\" onclick=\"App.selfHeal()\">\n          <span class=\"led-dot\"></span>\n          <span id=\"redLedLabel\" class=\"led-label hidden\">Heal &amp; Retry</span>\n        </button>\n      </div>\n      <span id=\"goalBadge\" class=\"badge goal\">Goal: Step 1 (IDLE)</span>\n    </div>\n    <div class=\"project-bar\">\n      <input id=\"projPath\" value=\"{{ project_root }}\" placeholder=\"C:\\path\\to\\your\\project\" onchange=\"App.setProject()\">\n      <button class=\"btn ghost\" onclick=\"App.openBrowser()\">Browse</button>\n    </div>\n  </header>\n\n  <main class=\"layout\">\n    <aside class=\"sidebar card\">\n      <div class=\"card-head\">\n        <div class=\"row\" style=\"gap:6px;\">\n          <h3>Project Files</h3>\n          <button class=\"btn ghost\" style=\"padding:2px 6px; font-size:11px;\" title=\"Smart Select with Brain\" onclick=\"App.smartSelect()\">🧠</button>\n        </div>\n        <span id=\"fileStats\" class=\"muted\">0 selected</span>\n      </div>\n      <div class=\"row\">\n        <input id=\"filter\" placeholder=\"Filter files... (type @ for mention)\" oninput=\"App.renderFiles()\" onkeyup=\"App.handleFilterKey(event)\">\n      </div>\n      <div id=\"fileList\" class=\"file-list\"></div>\n      <div class=\"token-meter\">\n        <span>Selected Context:</span>\n        <strong id=\"selectedTokens\">0 tokens</strong>\n      </div>\n    </aside>\n\n    <section class=\"workspace\">\n      <div id=\"inlinePopup\" class=\"inline-popup info\">\n        <div class=\"inline-popup-content\">\n          <span id=\"inlinePopupIcon\" class=\"popup-icon\">&#9432;</span>\n          <div class=\"inline-popup-text\">\n            <strong id=\"inlinePopupTitle\">Autonomous Relay Ready</strong>\n            <div id=\"inlinePopupMsg\" class=\"muted\">Type your goal below — line ranges auto-select and prompt auto-copies to clipboard.</div>\n          </div>\n        </div>\n        <div id=\"inlinePopupActions\" class=\"row wrap\"></div>\n      </div>\n\n      <details id=\"planPanel\" class=\"card plan-panel hidden\">\n        <summary class=\"plan-summary\">\n          <span>AI Implementation Plan &amp; Sub-tasks</span>\n          <span id=\"planMeta\" class=\"muted\">0 tasks</span>\n        </summary>\n        <div id=\"planOut\" class=\"plan-body\"></div>\n      </details>\n\n      <div id=\"stagePromptCard\" class=\"card\">\n        <div class=\"card-head\">\n          <h3>1. Goal (Press Enter or Ctrl+Enter to Launch)</h3>\n          <div class=\"row wrap\">\n            <span id=\"promptMeta\" class=\"muted\"></span>\n            <button class=\"btn primary\" onclick=\"App.buildPrompt(false)\">Send Goal &rarr;</button>\n            <button class=\"btn ghost\" onclick=\"App.openOptionsModal()\">&#9881;</button>\n          </div>\n        </div>\n        <div id=\"selectedChips\" class=\"chips\"></div>\n        <textarea id=\"task\" placeholder=\"Type your goal completely — relevant files preview as you type. Press Enter (or click Send Goal) when you are done typing...\"></textarea>\n      </div>\n\n      <div id=\"stagePasteCard\" class=\"card hidden\">\n        <div class=\"card-head\">\n          <h3>2. AI Response Relay (Auto-Captures Clipboard on Focus &amp; Paste)</h3>\n          <div class=\"row wrap\">\n            <div id=\"copyButtons\" class=\"row\"></div>\n            <span id=\"applyMeta\" class=\"muted\"></span>\n          </div>\n        </div>\n        <div id=\"promptPreviewWrap\" class=\"hidden\">\n          <textarea id=\"generatedPrompt\" class=\"mono small\" readonly></textarea>\n        </div>\n        <div id=\"pasteInputArea\" class=\"col\">\n          <input id=\"fallbackFile\" class=\"hidden\">\n          <textarea id=\"aiResponse\" class=\"mono\" placeholder=\"Switch back from AI chat after copying its response — Gomaa Relay auto-reads clipboard, applies edits, and copies the next step!\"></textarea>\n        </div>\n        <div id=\"questionsOut\" class=\"qa-container\"></div>\n        <div id=\"diffOut\" class=\"diff-container\"></div>\n      </div>\n    </section>\n  </main>\n\n  <div id=\"browserModal\" class=\"modal hidden\">\n    <div class=\"modal-card\">\n      <div class=\"card-head\">\n        <h3>Select Project Folder</h3>\n        <button class=\"btn ghost\" onclick=\"App.closeBrowser()\">Close</button>\n      </div>\n      <div id=\"driveBar\" class=\"row wrap\"></div>\n      <div class=\"row\">\n        <button id=\"upBtn\" class=\"btn ghost\" onclick=\"App.browseUp()\">&uarr; Up</button>\n        <input id=\"browsePath\" readonly>\n      </div>\n      <div id=\"dirList\" class=\"file-list\" style=\"max-height: 300px;\"></div>\n      <div class=\"row\" style=\"justify-content: flex-end;\">\n        <button class=\"btn success\" onclick=\"App.selectBrowsed()\">Select This Folder</button>\n      </div>\n    </div>\n  </div>\n\n  <div id=\"editorModal\" class=\"modal hidden\">\n    <div class=\"modal-card editor-modal-card\">\n      <div class=\"card-head\">\n        <div class=\"row\">\n          <h3 id=\"editorTitle\">file.py</h3>\n          <span id=\"editorLangBadge\" class=\"badge\">CODE</span>\n        </div>\n        <div class=\"row\">\n          <button class=\"btn ghost\" onclick=\"App.prettifyEditor()\">Prettify / Format</button>\n          <button class=\"btn success\" onclick=\"App.saveEditor()\">Save File</button>\n          <button class=\"btn ghost\" onclick=\"App.closeEditor()\">Close</button>\n        </div>\n      </div>\n      <div class=\"editor-wrap\">\n        <pre id=\"editorLines\" class=\"editor-gutter\">1</pre>\n        <textarea id=\"editorCode\" class=\"editor-textarea\" spellcheck=\"false\" oninput=\"App.syncEditorGutter()\" onscroll=\"App.syncEditorScroll()\"></textarea>\n      </div>\n    </div>\n  </div>\n\n  <div id=\"choiceModal\" class=\"modal hidden\">\n    <div class=\"modal-card\">\n      <div class=\"card-head\">\n        <h3 id=\"choiceModalTitle\">Choose an Option</h3>\n        <button class=\"btn ghost\" onclick=\"App.closeChoiceModal()\">Close</button>\n      </div>\n      <div id=\"choiceModalDesc\" class=\"muted\"></div>\n      <div id=\"choiceModalBody\" class=\"col\"></div>\n    </div>\n  </div>\n\n  <div id=\"contextMenu\" class=\"context-menu hidden\">\n    <div class=\"ctx-item\" onclick=\"App.ctxRename()\">✏️ Rename</div>\n    <div class=\"ctx-item danger\" onclick=\"App.ctxDelete()\">🗑️ Delete</div>\n  </div>\n\n  <div id=\"optionsModal\" class=\"modal hidden\">\n    <div class=\"modal-card\">\n      <div class=\"card-head\">\n        <h3>Prompt &amp; Automation Settings</h3>\n        <button class=\"btn success\" onclick=\"App.closeOptionsModal()\">Done</button>\n      </div>\n      <div class=\"col\">\n        <label class=\"chk\"><input type=\"checkbox\" id=\"includeTree\" checked> Include project file tree in prompt</label>\n        <label class=\"chk\"><input type=\"checkbox\" id=\"autoUnselect\" checked> Auto-unselect files after copying prompt</label>\n        <label class=\"chk\"><input type=\"checkbox\" id=\"autoSelectSmart\" checked> Auto-pick relevant files while typing goal</label>\n        <div class=\"row\">\n          <span class=\"muted\">Chunk size (chars):</span>\n          <input id=\"chunkSize\" type=\"number\" value=\"120000\" class=\"num-input\">\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <script src=\"{{ url_for('static', filename='app.js') }}\"></script>\n</body>\n</html>"}]